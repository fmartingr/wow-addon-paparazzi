std = "lua51"
max_line_length = 120
codes = true
exclude_files = { ".lua/", ".luarocks/", ".release/", "build/" }
ignore = { "212/self", "211/_.*", "212/_.*" }

globals = { "PaparazziDB", "SLASH_PAPARAZZI1", "SlashCmdList", "Paparazzi_OnAddonCompartmentClick" }

